// Cloudflare Worker configuration.
//
// The "Deploy to Cloudflare" button reads this file: it provisions the D1 database
// declared below, writes the real database_id into your copy of the repo, and wires
// the repo to Workers Builds so every push to main redeploys automatically
// (build command: `npm run build`, deploy command: `npx wrangler deploy`).
//
// Keep `main`, `assets` and the `DB` binding valid — the app reads all three.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manyfold-tarot",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  // tarot.manyfold.ai is the site's own host. It is also mounted at
  // app.manyfold.ai/tarot — two routes on the manyfold.ai zone, which is shared
  // with other apps, so neither pattern reaches past /tarot. Forks: delete the
  // two app.manyfold.ai entries and BASE_PATH below.
  "routes": [
    {
      "pattern": "tarot.manyfold.ai",
      "custom_domain": true
    },
    {
      "pattern": "app.manyfold.ai/tarot",
      "zone_name": "manyfold.ai"
    },
    {
      "pattern": "app.manyfold.ai/tarot/*",
      "zone_name": "manyfold.ai"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API, plus the three paths that serve an HTML document: the Worker
    // writes the Google tag into their <head> on the way past (and does nothing
    // at all when GA_MEASUREMENT_ID is unset). Card images and hashed bundles
    // are not in this list and never wake the Worker — except under BASE_PATH,
    // where everything does, because the prefix has to come off before the
    // assets runtime can find anything (src/worker/mount.ts).
    "run_worker_first": ["/api/*", "/", "/s/*", "/privacy", "/tarot", "/tarot/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manyfold-tarot-db",
      "database_id": "f05ec677-9cd9-4cba-85ac-864c1a4f5891"
    }
  ],
  "vars": {
    // Manyfold API base. Point at https://api-staging.manyfold.ai via .dev.vars for local dev.
    "MANYFOLD_API_BASE_URL": "https://api.manyfold.ai",
    // "production" enforces https-only and no-private-IP checks on agent URLs.
    "ENVIRONMENT": "production",
    // GA4 measurement id. Empty means no analytics is served at all, which is
    // what a fork should inherit — put your own id here to measure your own
    // deployment. Consent Mode v2 defaults ship with it (src/worker/analytics.ts).
    "GA_MEASUREMENT_ID": "G-CW6W545VTM",
    // Preview builds can override this to the matching Fortune Stick preview URL.
    "FORTUNE_STICK_URL": "https://app.manyfold.ai/fortune-stick/",
    // Requests under this prefix are served as if they had arrived at the root.
    // Keep it in step with the /tarot entries in routes and run_worker_first.
    "BASE_PATH": "/tarot"
  }
  // Two secrets, set with `npx wrangler secret put <NAME>` or in the dashboard:
  //   ADMIN_PASSWORD          the operator password for /settings, and the only one.
  //                           There is no default (this is a public repo, and a
  //                           committed lock only its author can open is worse than
  //                           none) — unset, the console does not open for anybody.
  //   CONFIG_ENCRYPTION_KEY   >=32 chars; otherwise a key is generated and stored in D1
}
